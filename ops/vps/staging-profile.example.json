{
  "format": 1,
  "automaticEnabled": false,
  "modelPolicy": "preserve",
  "project": "convy",
  "current": "/opt/convy/current",
  "stateRoot": "/opt/convy/cd-state",
  "incomingRoot": "/opt/convy/cd-incoming",
  "backupRoot": "/opt/convy/backups",
  "sharedLock": "/run/lock/shared-staging-deployment.lock",
  "modelEnv": "/opt/convy/shared/api.env",
  "envFiles": ["REPLACE_WITH_ALL_ORDERED_LIVE_ENV_FILES"],
  "composeFiles": ["REPLACE_WITH_ALL_ORDERED_LIVE_COMPOSE_FILES"],
  "composeHashes": {},
  "preserveFiles": ["REPLACE_WITH_REVIEWED_SHARED_CONFIG_AND_CREDENTIAL_FILES"],
  "schemaBaselineSha": "REPLACE_WITH_FULL_DEPLOYED_SCHEMA_SHA",
  "migrationSha256": "REPLACE_WITH_FULL_CATALOG_DIGEST",
  "composeSha256": "REPLACE_WITH_BASE_COMPOSE_DIGEST",
  "githubTokenFile": "/etc/convy-staging/github-read-token",
  "offsiteReceiptFile": "/etc/convy-staging/offsite-receipt.json",
  "offsiteExportCommand": ["/usr/bin/python3", "/FIXED_REVIEWED_TOOL_PATH/offsite-export.py", "--config", "/etc/convy-staging/offsite.json"],
  "minimumFreeBytes": 8589934592,
  "minimumAvailableMemoryBytes": 1073741824,
  "maximumIncomingBytes": 2147483648,
  "maximumReleaseBytes": 3221225472,
  "maximumRollbackArchiveBytes": 1073741824,
  "failedReleaseCount": 2,
  "failedReleaseMaxAgeSeconds": 86400,
  "applicationCaps": {
    "api": {"memoryBytes": 536870912, "cpus": 1.0},
    "worker": {"memoryBytes": 268435456, "cpus": 0.5},
    "dashboard": {"memoryBytes": 268435456, "cpus": 0.5},
    "auth": {"memoryBytes": 268435456, "cpus": 0.5},
    "mcp": {"memoryBytes": 268435456, "cpus": 0.5}
  },
  "applicationLogOptions": {"max-size": "10m", "max-file": "3"},
  "healthTimeoutSeconds": 120,
  "acceptance": [["REPLACE_WITH_BOUNDED_REVIEWED_REGRESSION_COMMAND"]]
}
