[Unit]
Description=Verify Convy PostgreSQL backup by restoring into a temporary database
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I -B /usr/local/libexec/shared_staging_lock.py -- /bin/bash /opt/convy/current/ops/vps/backups/restore-verify-postgres.sh
